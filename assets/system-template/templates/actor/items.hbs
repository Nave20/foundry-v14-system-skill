<section class="tab items {{tab.cssClass}}" data-group="primary" data-tab="items">
  {{#each itemGroups as |group|}}
  <div class="item-group">
    <header class="item-group-header">
      <h3>{{localize group.label}}</h3>
      {{#if @root.editable}}
      <button type="button" data-action="itemCreate" data-type="{{group.type}}"
              data-tooltip="{{localize "__IDU__.Item.Create"}}">
        <i class="fa-solid fa-plus" inert></i>
      </button>
      {{/if}}
    </header>
    <ol class="item-list">
      {{#each group.items as |item|}}
      <li class="item draggable" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="" class="item-img">
        <a class="item-name" data-action="itemUse">{{item.name}}</a>
        {{#if (eq item.type "gear")}}<span class="item-qty">×{{item.system.quantity}}</span>{{/if}}
        <div class="item-controls">
          <a data-action="itemEdit" data-tooltip="{{localize "__IDU__.Item.Edit"}}"><i class="fa-solid fa-pen-to-square" inert></i></a>
          {{#if @root.editable}}
          <a data-action="itemDelete" data-tooltip="{{localize "__IDU__.Item.Delete"}}"><i class="fa-solid fa-trash" inert></i></a>
          {{/if}}
        </div>
      </li>
      {{else}}
      <li class="empty">{{localize "__IDU__.Item.None"}}</li>
      {{/each}}
    </ol>
  </div>
  {{/each}}
</section>
